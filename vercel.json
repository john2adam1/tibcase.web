{
  "rewrites": [
    {
      "source": "/mobile/:path*",
      "destination": "https://prod.tibstation.uz/mobile/:path*"
    },
    {
      "source": "/web/:path*",
      "destination": "https://prod.tibstation.uz/web/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://prod.tibstation.uz/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://prod.tibstation.uz/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
